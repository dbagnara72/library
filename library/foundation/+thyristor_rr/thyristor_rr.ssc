component thyristor_rr
% Thyristor with Reverse Recovery (Lauritzen-Ma charge dynamics)
% ---------------------------------------------------------------
% Piecewise-linear SCR static characteristic + Lauritzen-Ma lumped
% charge model for reverse recovery, plus latching/holding logic.
% Default parameters: ABB 5STP 26N6500 (6.5 kV / 2880 A phase-control
% thyristor), typical values at Tvj = 125 degC.
%
% Static PWL characteristic (same form as Thyristor (Piecewise Linear)):
%   on:  i_s = (v - Vf*(1 - Ron*Goff))/Ron
%   off: i_s = v*Goff
%
% Charge model (as documented for the Simscape Diode block):
%   qE = (tau + Tm) * i_s                injected charge
%   der(qM) = (qE - qM)/Tm - qM/tau      stored charge
%   i  = (qE - qM)/Tm                    terminal current
%
% In forward steady state i -> i_s. During commutation the extraction
% of qM produces the reverse recovery current with soft exponential
% decay, time constant tau_rr = tau*Tm/(tau+Tm).
%
% Latching logic (event variable 'on'):
%   turn ON  : gate signal G > Vgt while v > 0
%   turn OFF : i < Ih while gate is low; the turn-off instant is
%              stored in 'toff'
%   re-trigger: forward voltage reapplied while EITHER
%     (a) stored charge qM > Qth  (physical, early phase), OR
%     (b) time - toff < tq        (explicit timer, enforces the full
%         datasheet tq, which the two-charge model cannot sustain
%         through residual charge alone since qM decays with tau_rr)
%
% Gate is a physical signal input (simplest robust choice; replace
% with an electrical gate node + Rg if you need gate-circuit loading).

  nodes
    a = foundation.electrical.electrical; % A:left
    k = foundation.electrical.electrical; % K:right
  end

  inputs
    % gate command (compare against Vgt)
    G = {0, 'V'}; % G:left  
  end

  parameters
    Vf   = {1.12,    'V'    };  % Forward voltage (VT0, 125 degC)
    Ron  = {0.29e-3, 'Ohm'  };  % On-state resistance (rT, 125 degC)
    Goff = {1e-5,    '1/Ohm'};  % Off-state conductance (IRRM/VRRM worst case)
    Vgt  = {1.2,     'V'    };  % Gate trigger threshold
    Il   = {0.25,    'A'    };  % Latching current (125 degC)
    Ih   = {0.075,   'A'    };  % Holding current (125 degC)
    tau  = {100e-6,  's'    };  % Carrier lifetime (transit time)
    Tm   = {160e-6, 's'    };   % Charge cross-over time constant
    Qth  = {1e-6,    'C'    };  % Residual-charge re-trigger threshold
    tq   = {800e-6,  's'    };  % Circuit-commutated turn-off time (timer)
  end

  parameters (Access = private)
    Kq = tau + Tm;              % qE gain so that i -> i_s in steady state
  end

  variables
    i  = {0, 'A'};              % Through variable A->K
    v  = {0, 'V'};              % Across variable A-K
    qM = {value = {0, 'C'}, priority = priority.high}; % Stored charge
  end

  variables (Event = true)
    on   = 0;                   % Latch state: 0 = blocking, 1 = conducting
    toff = {-1, 's'};           % Time of last turn-off event
  end

  intermediates
    % Static PWL current
    i_s = if on > 0.5, (v - Vf*(1 - Ron*Goff))/Ron else v*Goff end;
    % Injected charge
    qE  = Kq * i_s;
  end

  branches
    i : a.i -> k.i;
  end

  equations
    v == a.v - k.v;
    % Lauritzen-Ma lumped charge dynamics
    der(qM) == (qE - qM)/Tm - qM/tau;
    i       == (qE - qM)/Tm;
  end

  events
    when edge((G > Vgt) && (v > {50,'V'}) && (on < 0.5))
      on = 1;                   % gate turn-on
    elsewhen edge((v > {50,'V'}) && (on < 0.5) && ...
            ((qM > Qth) || (time - toff < tq)))
      on = 1;                 % tq violation: spontaneous re-fire
    elsewhen edge((i < Ih) && (on > 0.5))
      on   = 0;                 % natural commutation below holding
      toff = time;              % start tq timer
    end
  end

  annotations
    a : Side = left;
    k : Side = right;
    G : Side = bottom;
  end

end
