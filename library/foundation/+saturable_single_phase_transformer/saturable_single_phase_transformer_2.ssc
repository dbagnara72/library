component saturable_single_phase_transformer
% saturable single phase transformer

    nodes
        u1_p = foundation.electrical.electrical; % u1(+):left
        u1_n = foundation.electrical.electrical; % u1(-):left        
        u2_p = foundation.electrical.electrical; % u2(+):right
        u2_n = foundation.electrical.electrical; % u2(-):right
    end
    
    outputs
        Bc = { 0, 'Wb/m^2' };                       % Bc:right
        phi_out = { 0, 'V*s' };                     % phi:right
        i1_out = { 0, 'A' };                        % i1_out:right
        i2_out = { 0, 'A' };                        % i2_out:right
        im_out = { 0, 'A' };                        % im_out:right
        u1_out = { 0, 'V' };                        % u1_out:right
        u2_out = { 0, 'V' };                        % u2_out:right
    end

    parameters
        en_sat = {0, '1'};                      % Enable Saturation
        n1 = {43, '1'};                         % n1
        n2 = {25, '1'};                         % n2
        core_area = {0.05, 'm^2'};              % core_area (m^2)
        length_m = {2.5, 'm'};                  % length_m (m)
        Rd1 = {2e-3, 'Ohm'};                    % Rd1 (Ohm)
        Rd2 = {2e-3, 'Ohm'};                    % Rd2 (Ohm)
        Ld1 = {30e-6, 'H'};                     % Ld1 (H)
        Ld2 = {30e-6, 'H'};                     % Ld2 (H)
        Rfe = {260, 'Ohm'};                     % Rfe1 (Ohm)
        mu0 = {1.256637e-6, 'H/m'};             % mu_0 (H/m)
        mur = {20e3, '1'};                      % mu_r
        phi_sat = {0.1, 'V*s'};                 % phi_sat (Vs)
    end

    variables
        phi = { 0, 'V*s' };                     % phi
        i1 = { 0, 'A' };                        % i1
        i2 = { 0, 'A' };                        % i2
        im = { 0, 'A' };                        % im
        ife = { 0, 'A' };                       % ife
        u1 = { 0, 'V' };                        % u1
        u2 = { 0, 'V' };                        % u2  
        end


    branches
        i1 : u1_p.i -> u1_n.i;
        i2 : u2_p.i -> u2_n.i;
    end

    equations
        let
            Lm = (n1^2 * mu0 * mur * core_area) / length_m;
        in
            u1 == u1_p.v - u1_n.v;
            u2 == u2_p.v - u2_n.v;
            
            % magnetizing current calculation (referred to primary)
            im == (i1 - ife) + (n2/n1) * i2;

            if en_sat == 1
                % non-linear Saturation (arctan model)
                % this smoothly limits phi as im grows large (saturation is basically related to the voltage)
                phi == phi_sat * (2/pi) * atan((pi/2) * (Lm * im) / (n1 * phi_sat));
            else
                % standard linear model
                phi == (Lm * im) / n1;
            end

                % Voltage equations using flux derivative
                u1 - Rd1 * i1 - Ld1 * i1.der == n1 * phi.der;
                u2 - Rd2 * i2 - Ld2 * i2.der == n2 * phi.der;
                
                % Core loss current
                ife == (u1 - Rd1 * i1 - Ld1 * i1.der) / Rfe;
            
                % Output assignments
                phi_out == phi;
                i1_out == i1;
                i2_out == i2;
                im_out == im;
                Bc == (mu0 * mur) * (n1*(i1-ife) + n2*i2) / length_m;
                u1_out == u1;
                u2_out == u2;
        end
    end
end
